# Copy to system/.env (gitignored) and fill in real values.
# Never commit the real .env.
# n8n Cloud does not read this file — paste the same keys into n8n Credentials.

# --- LLM providers (n8n → Credentials → OpenAI / Anthropic / OpenRouter) ---
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Langfuse EU (must match the project region) ---
# Project: https://cloud.langfuse.com/project/cmthhhzzv02wsad0d4qogeznv
# Host has no leading space and no trailing slash. Do not use us.cloud.langfuse.com.
LANGFUSE_SECRET_KEY=sk-lf-your-secret
LANGFUSE_PUBLIC_KEY=pk-lf-your-public
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=cmthhhzzv02wsad0d4qogeznv
LANGFUSE_TRACING_ENVIRONMENT=prd-genie-capstone
LANGFUSE_RELEASE=R1
# v4 OTLP ingest (replaces POST /api/public/ingestion)
LANGFUSE_OTLP_TRACES_URL=https://cloud.langfuse.com/api/public/otel/v1/traces

# --- IK n8n (login in the browser; no API token required for the canvas) ---
N8N_INSTANCE_URL=https://agenticai100.app.n8n.cloud
