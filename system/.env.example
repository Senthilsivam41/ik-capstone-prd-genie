# Copy to system/.env (gitignored) and fill in real values.
# Never commit the real .env.

# --- LLM providers (use the ones you actually wire in LangFlow) ---
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Langfuse observability (cloud.langfuse.com → Settings → API Keys) ---
LANGFUSE_SECRET_KEY=sk-lf-your-secret
LANGFUSE_PUBLIC_KEY=pk-lf-your-public
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: LangFlow also reads these names
LANGFUSE_TRACING_ENVIRONMENT=prd-genie-capstone
