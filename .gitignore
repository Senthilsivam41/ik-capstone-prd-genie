# Secrets — never commit real keys
.env
.env.local
.env.*.local
credentials.json
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python / local tooling
__pycache__/
*.pyc
.venv/
venv/
graphify-out/

# LangFlow / Langfuse local caches
.langflow/
langflow.db
*.langfuse*

# Local junk — never pack installers or scratch n8n dumps
*.dmg
system/workflows/*-bkup.json
system/workflows/*-5Sept.json

# Demo: keep small committed clip (demo/prd-genie-demo.*); ignore raw masters
demo/raw/
demo/*.mov.raw
demo/*.uncompressed.*
